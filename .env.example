# Inoichi holds no secrets and talks to no external service, so this file only
# carries the three settings the serve command reads. Copy it to .env and source
# it, or pass the same values as flags.

# Address the server binds. Keep it on loopback unless you are deliberately
# exposing the app on your network; there is no authentication.
INOICHI_HOST=127.0.0.1

# Port the server listens on.
INOICHI_PORT=8080

# Directory holding one JSON file per map. Defaults to ./data in the working
# directory. Back this up by copying it.
INOICHI_DATA_DIR=
